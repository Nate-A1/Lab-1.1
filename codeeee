#include <iostream>
#include <cmath>
using namespace std;
double fact(double n) {
	if (n == 0.0) {
		return 1;
	}
	else {
		return n * fact(n - 1);
	}
}

double st(double x, double n) {
	double k = 1;
	for (int i = 0; i < n; i++) {
		k = k * x;
	}
	return k;
}

int main() {
	double n = 1;
    double x;
	cout << "Enter x: ";
    cin >> x;

	x = fmod(x, 2 * M_PI);
	if (x > M_PI) x -= 2 * M_PI;
	if (x < -M_PI) x += 2 * M_PI;

	int iter1 = 0, iter2 = 0, iter3 = 0;
	double y1 = 1.0, y2 = 1.0, y3 = 1.0;
    while (n > 0) {
		if (st(x, 2*n) / fact(2*n) >= 1/st(10, 2)) {
			y1 = y1 + st(-1,n) * st(x, 2*n) / fact(2*n);
			iter1 += 1;
		}
		if (st(x, 2*n) / fact(2*n) >= 1/st(10, 4)) {
			y2 = y2 + st(-1,n) * st(x, 2*n) / fact(2*n);
			iter2 += 1;
		}
		if (st(x, 2*n)  / fact(2*n) >= 1/st(10, 6)) {
			y3 = y3 + st(-1,n) * st(x, 2*n) / fact(2*n);
			iter3 += 1;
		}else{
			break;
		}

        n++;
    }
	cout << "y1 (10^-2) = " << y1 << ", iteration: " << iter1 << endl;
	cout << "y2 (10^-4) = " << y2 << ", iteration: " << iter2 << endl;
	cout << "y3 (10^-6) = " << y3 << ", iteration: " << iter3 << endl;
	cout << " cos(x) = " << cos(x) << endl;
	return 0;
}

